<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Inquisitron - Sysmon Log Viewer</AssemblyTitle>
    <!-- Bump Version deliberately per release. The build timestamp below is
         appended automatically to ProductVersion (e.g. 1.0.0+build.20260801-2145)
         so two builds of the same Version are still distinguishable — check with:
         (Get-Item Inquisitron.exe).VersionInfo.ProductVersion -->
    <Version>1.1.1</Version>
    <SourceRevisionId>build.$([System.DateTime]::UtcNow.ToString("yyyyMMdd-HHmm"))</SourceRevisionId>
    <!-- Without this, single-file publish leaves WPF's native DLLs
         (PresentationNative_cor3 etc.) beside the exe and the "standalone" exe
         dies silently on any machine they weren't copied to. With it, they ride
         inside the exe and extract to %TEMP%\.net\Inquisitron on first launch. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- AI chat was removed (telemetry should not leave the analyst's machine).
       These exclusions let the build succeed whether or not the orphaned files
       have been deleted yet; they are harmless once the files are gone, and
       this whole ItemGroup can then be deleted too. -->
  <ItemGroup>
    <Compile Remove="Services\AiChatService.cs" />
    <Compile Remove="Services\ChatContext.cs" />
    <Compile Remove="Models\ChatMessage.cs" />
  </ItemGroup>

  <!-- Tests\ holds its own console project (DetectionTests); keep its sources
       out of the app's default glob. -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

</Project>
