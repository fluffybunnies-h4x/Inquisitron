  // ==========================================================================
  // Cross-channel rules
  //
  // These use the optional "channels" gate: a list of case-insensitive
  // substrings matched against the event's channel. Omit "channels" and a rule
  // applies everywhere, which is usually what you want — a malicious command
  // line is malicious whether it arrived as Sysmon 1 or Security 4688. Gate a
  // rule when its event IDs or field names only mean something on one channel.
  // ==========================================================================

  {
    "name": "Service installed from user-writable path",
    "description": "System 7045 — a service was installed pointing at a binary in TEMP/AppData/Public/Downloads. This is the classic PsExec / Cobalt Strike / remote-exec footprint and runs as SYSTEM; Sysmon alone will not show it",
    "severity": "critical",
    "channels": ["System"],
    "eventIds": [7045],
    "any": [
      { "field": "ImagePath", "regex": "\\\\AppData\\\\" },
      { "field": "ImagePath", "regex": "\\\\Temp\\\\" },
      { "field": "ImagePath", "regex": "\\\\Users\\\\Public\\\\" },
      { "field": "ImagePath", "regex": "\\\\Downloads\\\\" },
      { "field": "ImagePath", "regex": "\\\\ProgramData\\\\" },
      { "field": "ImagePath", "regex": "(powershell|pwsh|cmd|wscript|cscript|rundll32|regsvr32)\\.exe" }
    ]
  },

  {
    "name": "Service installed",
    "description": "System 7045 / Security 4697 — a new Windows service was registered. Routine during software installs, but the standard persistence and lateral-movement primitive; correlate against the Sysmon process tree at the same timestamp",
    "severity": "medium",
    "channels": ["System", "Security"],
    "eventIds": [7045, 4697]
  },

  {
    "name": "Event log cleared",
    "description": "Security 1102 or System 104 — an event log was cleared. Almost never legitimate on a workstation and a strong anti-forensics signal; note that everything before it may be gone",
    "severity": "critical",
    "channels": ["Security", "System"],
    "eventIds": [1102, 104]
  },

  {
    "name": "PowerShell script block with evasion tradecraft",
    "description": "PowerShell 4104 script block logging captured the decoded script body — this catches obfuscated payloads that never appear on a command line, so it sees what Sysmon Event 1 cannot",
    "severity": "critical",
    "channels": ["PowerShell"],
    "eventIds": [4104],
    "any": [
      { "field": "ScriptBlockText", "regex": "amsiInitFailed" },
      { "field": "ScriptBlockText", "regex": "AmsiUtils" },
      { "field": "ScriptBlockText", "regex": "AmsiScanBuffer" },
      { "field": "ScriptBlockText", "regex": "FromBase64String" },
      { "field": "ScriptBlockText", "regex": "(Add|Set)-MpPreference[^\\n]*-Exclusion" },
      { "field": "ScriptBlockText", "regex": "(DownloadString|DownloadFile|Invoke-WebRequest|Net\\.WebClient)" },
      { "field": "ScriptBlockText", "regex": "Add-Type[^\\n]*-(Language|TypeDefinition)" },
      { "field": "ScriptBlockText", "regex": "(VirtualAlloc|WriteProcessMemory|CreateRemoteThread|memcpy)" },
      { "field": "ScriptBlockText", "regex": "PartOfDomain" }
    ]
  },

  {
    "name": "Defender protection disabled",
    "description": "Defender's own Operational log reporting that real-time or scanning protection was turned off — the victim-side confirmation that a Defender-tampering command actually succeeded",
    "severity": "critical",
    "channels": ["Defender"],
    "eventIds": [5001, 5004, 5010, 5012, 1119]
  },

  {
    "name": "Explicit-credential logon",
    "description": "Security 4648 — a process authenticated using credentials other than the logged-on user's. Normal for runas and some admin tooling, but this is what pass-the-hash and lateral movement look like from the target's side",
    "severity": "medium",
    "channels": ["Security"],
    "eventIds": [4648]
  },

  {
    "name": "Privileged group membership changed",
    "description": "Security 4728/4732/4756 — an account was added to a security-enabled group. Correlate with recent process activity: a group change minutes after a suspicious spawn is a privilege-escalation footprint",
    "severity": "high",
    "channels": ["Security"],
    "eventIds": [4728, 4732, 4756]
  },

  // ==========================================================================
  // Persistence (batch-script campaigns lean on these heavily)
  // ==========================================================================

  {
    "name": "Run key persistence",
    "description": "Registry Run/RunOnce key written — the most common persistence mechanism for script-based loaders",
    "severity": "high",
    "eventIds": [12, 13],
    "any": [
      { "field": "TargetObject", "regex": "\\\\CurrentVersion\\\\Run(Once)?\\\\" },
      { "field": "TargetObject", "regex": "\\\\CurrentVersion\\\\RunServices(Once)?\\\\" },
      { "field": "TargetObject", "regex": "\\\\Winlogon\\\\(Shell|Userinit)" }
    ]
  },

  {
    "name": "Scheduled task created",
    "description": "Scheduled task registered from a command line — persistence, or a delayed execution stage to break EDR correlation windows",
    "severity": "high",
    "eventIds": [1],
    "any": [
      { "field": "CommandLine", "regex": "schtasks[^\\n]*/create" },
      { "field": "CommandLine", "regex": "Register-ScheduledTask" },
      { "field": "CommandLine", "regex": "New-ScheduledTask" }
    ]
  },

  {
    "name": "Startup folder persistence",
    "description": "File written to a Startup folder — runs automatically at next logon",
    "severity": "high",
    "eventIds": [11],
    "all": [
      { "field": "TargetFilename", "regex": "\\\\Start Menu\\\\Programs\\\\Startup\\\\" }
    ]
  },

  {
    "name": "Service installed from user-writable path",
    "description": "Service created pointing at a binary in TEMP/AppData/Public — persistence with SYSTEM-level execution",
    "severity": "critical",
    "eventIds": [1],
    "all": [
      { "field": "CommandLine", "regex": "(sc(\\.exe)?\\s+create|New-Service)" }
    ],
    "any": [
      { "field": "CommandLine", "regex": "\\\\AppData\\\\" },
      { "field": "CommandLine", "regex": "\\\\Temp\\\\" },
      { "field": "CommandLine", "regex": "\\\\Users\\\\Public\\\\" }
    ]
  },

  {
    "name": "Anti-correlation sleep",
    "description": "Long deliberate delay before the next stage — SMOKE#SCREEN's loader.cs carries the comment \"WAIT 3 MINUTES (Breaks Elastic correlation)\" and sleeps 180 seconds to fall outside EDR correlation windows",
    "severity": "high",
    "eventIds": [1],
    "any": [
      { "field": "CommandLine", "regex": "(timeout|sleep)[^\\n]*\\b([1-9]\\d{2,})\\b" },
      { "field": "CommandLine", "regex": "Start-Sleep[^\\n]*\\b([1-9]\\d{2,})\\b" },
      { "field": "CommandLine", "regex": "ping[^\\n]*-n\\s+([1-9]\\d{2,})" }
    ]
  },

  // ==========================================================================
  // Generic PowerShell / execution tradecraft
  // ==========================================================================

  {
    "name": "Encoded PowerShell command",
    "description": "PowerShell executed a base64-encoded command block",
    "severity": "high",
    "eventIds": [1],
    "child": "(powershell|pwsh)\\.exe",
    "any": [
      { "field": "CommandLine", "regex": "\\s-[eE][ncodemas]*\\s+[A-Za-z0-9+/=]{40,}" },
      { "field": "CommandLine", "regex": "FromBase64String" }
    ]
  },

  {
    "name": "Hidden-window PowerShell",
    "description": "PowerShell launched with a hidden window and/or execution-policy bypass",
    "severity": "medium",
    "eventIds": [1],
    "child": "(powershell|pwsh)\\.exe",
    "any": [
      { "field": "CommandLine", "regex": "-(w|windowstyle)\\s+h" },
      { "field": "CommandLine", "regex": "-(ep|exec|executionpolicy)\\s+bypass" },
      { "field": "CommandLine", "regex": "-nop\\b" }
    ]
  },

  // ==========================================================================
  // Generic abnormal parentage (keep — catches non-campaign activity too)
  // ==========================================================================

  {
    "name": "Office spawned LOLBin",
    "parent": "(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote)\\.exe",
    "child": "(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|bitsadmin|certutil|msbuild|installutil|msiexec)\\.exe",
    "description": "Office application spawned a shell/LOLBin (common macro/phishing execution)",
    "severity": "critical"
  },
  {
    "name": "Browser spawned shell",
    "parent": "(chrome|msedge|firefox|iexplore|brave|opera)\\.exe",
    "child": "(cmd|powershell|pwsh|wscript|cscript|mshta)\\.exe",
    "description": "Browser spawned a shell/script host — matches the zoom-update.html and Adobe Flash fake-update lures",
    "severity": "high"
  },
  {
    "name": "Script host spawned LOLBin",
    "parent": "(mshta|wscript|cscript)\\.exe",
    "child": "(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32|bitsadmin|certutil|msbuild|installutil|msiexec)\\.exe",
    "description": "Script host spawned a shell/LOLBin (script-based dropper chain)",
    "severity": "high"
  },
  {
    "name": "Server spawned shell",
    "parent": "(sqlservr|w3wp|httpd|nginx|tomcat\\w*|php-cgi)\\.exe",
    "child": "(cmd|powershell|pwsh|wscript|cscript|sh|bash)\\.exe",
    "description": "Server process spawned a shell (possible webshell)",
    "severity": "critical"
  },
  {
    "name": "LSASS spawned child",
    "parent": "lsass\\.exe",
    "child": ".*",
    "description": "LSASS spawned a child process (LSASS should not create children)",
    "severity": "critical"
  },
  {
    "name": "Scheduled task spawned shell",
    "parent": "(schtasks|taskeng)\\.exe",
    "child": "(cmd|powershell|pwsh|wscript|cscript|mshta)\\.exe",
    "description": "Scheduled task spawned a shell (persistence execution)",
    "severity": "medium"
  }
]
