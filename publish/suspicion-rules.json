      { "field": "CommandLine", "regex": "Mount-(DiskImage|VHD)" },
      { "field": "CommandLine", "regex": "diskpart[^\\n]*(attach|select)\\s+vdisk" },
      { "field": "CommandLine", "regex": "PowerShell[^\\n]*\\.(vhdx?|iso|img)\\b" }
    ]
  },

